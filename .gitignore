# ─── DATOS REALES — NUNCA A GIT ────────────────────────────────────
# Extractos bancarios: CUITs, nombres y montos de gente real.
*.xlsx
*.xls
*.csv

# Imágenes de comprobantes reales.
comprobantes/
comprobantesReales/
*.jpeg
*.jpg
*.png
*.webp
*.heic
*.pdf

# Dumps de la base.
*.sql.gz
*.dump

# Excepción única a `*.csv`: los CSV del tablero de Looker Studio. Son aciertos del modelo
# (0/1 por campo), curvas de loss e hiperparámetros — ni un CUIT, ni un monto, ni un nombre.
# `metricas/corridas.csv` está escrito a mano y no se regenera solo: sin esto se pierde.
# Acotada a esta carpeta a propósito: cualquier otro .csv sigue fuera de git.
!metricas/*.csv

# Salidas de la IA: llevan los 16 campos extraídos de comprobantes reales.
# La verdad de referencia es el archivo más sensible del proyecto.
*.jsonl
*.tsv


# ─── INTENTO ANTERIOR ──────────────────────────────────────────────
# Referencia local de solo lectura. No se versiona.
viejo/


# ─── MODELOS Y ENTRENAMIENTO ───────────────────────────────────────
adapters/
*.safetensors
*.gguf


# ─── PYTHON ────────────────────────────────────────────────────────
env/
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/


# ─── NODE / NEXT.JS ────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo


# ─── ENTORNO Y SECRETOS ────────────────────────────────────────────
.env
.env.*
!.env.example


# ─── HERRAMIENTAS ──────────────────────────────────────────────────
.claude/settings.local.json
.DS_Store
.idea/
.vscode/

# Portal del cliente: los comprobantes que suben son datos reales
portal/comprobantes/
